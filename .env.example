# 預設 Generator（OpenAICompatGenerator）的端點；CLI 與 demo 後端都讀這三個變數。
# 複製成 .env 後填值；.env 已被 gitignore，不要 commit。
# 以 `uv run --env-file .env ...` 載入。

# 本機 Ollama（預設）
SHOWRECEIPTS_BASE_URL=http://localhost:11434/v1
SHOWRECEIPTS_MODEL=qwen3.5:4b-mlx
SHOWRECEIPTS_API_KEY=ollama

# OpenAI：temperature 固定為 0，請選接受 temperature=0 的模型
# SHOWRECEIPTS_BASE_URL=https://api.openai.com/v1
# SHOWRECEIPTS_MODEL=
# SHOWRECEIPTS_API_KEY=
